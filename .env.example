# =============================================================================
# Car Rental System — global environment file for docker-compose
#
#   cp .env.example .env      (then adjust values if needed)
#   docker compose up --build
#
# docker compose reads .env automatically and substitutes ${VARS} in
# docker-compose.yml. .env is git-ignored; .env.example is the committed template.
# These are DEVELOPMENT credentials only — never reuse them anywhere real.
# =============================================================================

COMPOSE_PROJECT_NAME=carrental

# --- Container images ---------------------------------------------------------
# Matches what the CI pipeline pushes: ghcr.io/<github-owner>/carrental-<service>:<tag>
# IMAGE_NAMESPACE must be lowercase (your GitHub user or organisation name).
REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-github-username
IMAGE_TAG=latest

# --- ASP.NET Core -------------------------------------------------------------
# Development turns on Swagger UI at /swagger on every service.
ASPNETCORE_ENVIRONMENT=Development

# --- Host ports for the APIs (container port is always 8080) ------------------
# Same numbers as the http:// URLs in each launchSettings.json.
USER_SERVICE_PORT=6001
CAR_SERVICE_PORT=6002
BOOKING_SERVICE_PORT=6003
NOTIFICATION_SERVICE_PORT=6004
PAYMENT_SERVICE_PORT=6005

# --- RabbitMQ (single broker instance) ----------------------------------------
RABBITMQ_USER=carrental
RABBITMQ_PASSWORD=carrental_dev_pw
RABBITMQ_EXCHANGE=carrental.events
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Databases (one PostgreSQL server container per service) -------------------
# Host ports are only for connecting from your IDE / DB tool (e.g. Rider, DBeaver).
# Inside Docker the services use <name>-db:5432.
USER_DB_NAME=user_db
USER_DB_USER=user_svc
USER_DB_PASSWORD=user_dev_pw
USER_DB_PORT=5433

CAR_DB_NAME=car_db
CAR_DB_USER=car_svc
CAR_DB_PASSWORD=car_dev_pw
CAR_DB_PORT=5434

BOOKING_DB_NAME=booking_db
BOOKING_DB_USER=booking_svc
BOOKING_DB_PASSWORD=booking_dev_pw
BOOKING_DB_PORT=5435

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_svc
PAYMENT_DB_PASSWORD=payment_dev_pw
PAYMENT_DB_PORT=5436

# Notification Service has no database — by design.
